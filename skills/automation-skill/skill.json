{
  "schema_version": "1",
  "id": "automation-skill",
  "name": "Automation",
  "version": "1.3.0",
  "description": "Create, manage, and run scheduled tasks; execute shell commands and Python programs in the workspace; connect to remote servers over SSH and run commands there; send messages to the user in the interface.",
  "entrypoint": "tools/",
  "implementation_type": "declarative",
  "author": "Auren-AI",
  "required_integrations": [],
  "required_permissions": [
    "tasks.manage",
    "workspace.execute",
    "notifications.send"
  ],
  "tools": [
    {
      "tool_name": "task_create",
      "description": "Create a task. Provide a title, an objective (what to do), and optionally a schedule with a 5-field cron expression (UTC) for recurring work. Use this when the user asks for recurring or scheduled work. Pass project_id to keep the task inside the right project.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Short task name"
          },
          "objective": {
            "type": "string",
            "description": "What the task should do when it runs"
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string",
                "description": "5-field cron in UTC, e.g. '40 19 * * *' for 16:40 in America/Sao_Paulo"
              }
            }
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone, e.g. America/Sao_Paulo"
          },
          "project_id": {
            "type": "string",
            "description": "Project id or exact project name. Omit for the default board."
          }
        },
        "required": [
          "title",
          "objective"
        ]
      },
      "risk_class": "medium",
      "implementation_type": "declarative",
      "implementation_ref": "task_create"
    },
    {
      "tool_name": "task_list",
      "description": "List the user's tasks with their schedules and statuses.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Only list tasks from this project (id or name)."
          }
        },
        "required": []
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "task_list"
    },
    {
      "tool_name": "task_update",
      "description": "Update a task's title, objective, or schedule.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "task_id"
        ]
      },
      "risk_class": "medium",
      "implementation_type": "declarative",
      "implementation_ref": "task_update"
    },
    {
      "tool_name": "task_delete",
      "description": "Permanently delete a task and its schedule.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "risk_class": "high",
      "implementation_type": "declarative",
      "implementation_ref": "task_delete"
    },
    {
      "tool_name": "task_pause",
      "description": "Pause a task's future executions.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "task_pause"
    },
    {
      "tool_name": "task_resume",
      "description": "Resume a paused task.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "task_resume"
    },
    {
      "tool_name": "task_run",
      "description": "Run a task immediately.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "risk_class": "medium",
      "implementation_type": "declarative",
      "implementation_ref": "task_run"
    },
    {
      "tool_name": "exec_shell",
      "description": "Execute a shell command in the workspace (60s timeout). High risk: requires approval by default.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ]
      },
      "risk_class": "high",
      "implementation_type": "declarative",
      "implementation_ref": "exec_shell"
    },
    {
      "tool_name": "exec_python",
      "description": "Execute a Python program: inline code or a workspace file (60s timeout). High risk: requires approval by default.",
      "input_schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Inline Python code"
          },
          "file": {
            "type": "string",
            "description": "Workspace file to run"
          }
        }
      },
      "risk_class": "high",
      "implementation_type": "declarative",
      "implementation_ref": "exec_python"
    },
    {
      "tool_name": "ssh_connect",
      "description": "Register an SSH connection to a remote server so commands can be run on it later with exec_ssh. Authentication uses the server host's key-based SSH setup (no passwords). High risk: requires approval by default.",
      "input_schema": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "Hostname or IP of the remote server"
          },
          "user": {
            "type": "string",
            "description": "Remote username (optional)"
          },
          "port": {
            "type": "integer",
            "description": "SSH port (default 22)"
          },
          "name": {
            "type": "string",
            "description": "Friendly name; defaults to user@host"
          }
        },
        "required": [
          "host"
        ]
      },
      "risk_class": "high",
      "implementation_type": "declarative",
      "implementation_ref": "ssh_connect"
    },
    {
      "tool_name": "ssh_list",
      "description": "List the registered SSH connections.",
      "input_schema": {
        "type": "object"
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "ssh_list"
    },
    {
      "tool_name": "exec_ssh",
      "description": "Run a shell command on a registered remote server over SSH (60s timeout). High risk: requires approval by default.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "description": "Connection registered with ssh_connect"
          },
          "command": {
            "type": "string",
            "description": "Shell command to run on the remote server"
          }
        },
        "required": [
          "connection_id",
          "command"
        ]
      },
      "risk_class": "high",
      "implementation_type": "declarative",
      "implementation_ref": "exec_ssh"
    },
    {
      "tool_name": "ssh_disconnect",
      "description": "Remove a registered SSH connection. High risk: requires approval by default.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string"
          }
        },
        "required": [
          "connection_id"
        ]
      },
      "risk_class": "high",
      "implementation_type": "declarative",
      "implementation_ref": "ssh_disconnect"
    },
    {
      "tool_name": "notify_user",
      "description": "Send a message to the user in the interface (appears as a notification). Use it to report task results, findings, or important information.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "notify_user"
    },
    {
      "tool_name": "subagent_create",
      "description": "Create a specialized subagent with its own instructions. Use it to delegate focused work (research, analysis, writing) to a dedicated helper.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Subagent name, e.g. 'Researcher'"
          },
          "instructions": {
            "type": "string",
            "description": "What this subagent is and how it should work"
          }
        },
        "required": [
          "name",
          "instructions"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "subagent_create"
    },
    {
      "tool_name": "subagent_delegate",
      "description": "Delegate an objective to a subagent. The subagent runs with its own instructions and tools, and returns its final result.",
      "input_schema": {
        "type": "object",
        "properties": {
          "subagent_id": {
            "type": "string"
          },
          "objective": {
            "type": "string",
            "description": "What the subagent should accomplish"
          }
        },
        "required": [
          "subagent_id",
          "objective"
        ]
      },
      "risk_class": "medium",
      "implementation_type": "declarative",
      "implementation_ref": "subagent_delegate"
    },
    {
      "tool_name": "subagent_list",
      "description": "List the available agents and subagents.",
      "input_schema": {
        "type": "object"
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "subagent_list"
    },
    {
      "tool_name": "subagent_delete",
      "description": "Delete a subagent that is no longer needed. Use it to clean up one-off helpers after their work is done.",
      "input_schema": {
        "type": "object",
        "properties": {
          "subagent_id": {
            "type": "string"
          }
        },
        "required": [
          "subagent_id"
        ]
      },
      "risk_class": "medium",
      "implementation_type": "declarative",
      "implementation_ref": "subagent_delete"
    },
    {
      "tool_name": "task_move",
      "description": "Move a task card to another board column: analysis, todo, in_progress or done. Moving is only organizational and never starts work.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id"
          },
          "stage": {
            "type": "string",
            "enum": [
              "analysis",
              "todo",
              "in_progress",
              "done"
            ],
            "description": "Target column"
          }
        },
        "required": [
          "task_id",
          "stage"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "task_move"
    },
    {
      "tool_name": "task_assign",
      "description": "Assign a task to yourself for immediate execution: moves it to in_progress and queues a run. Use when the user asks you to do the work now, or to delegate it to a parallel run. It fails when the task is blocked by unfinished linked tasks.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "risk_class": "medium",
      "implementation_type": "declarative",
      "implementation_ref": "task_assign"
    },
    {
      "tool_name": "task_note",
      "description": "Write a note on a task card: decisions, findings, or progress the user must see later.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id"
          },
          "body": {
            "type": "string",
            "description": "Note text"
          }
        },
        "required": [
          "task_id",
          "body"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "task_note"
    },
    {
      "tool_name": "task_link",
      "description": "Reference another task from this one. Use kind 'blocks' when the other task must finish first, 'relates' otherwise.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task being annotated"
          },
          "related_task_id": {
            "type": "string",
            "description": "The other task"
          },
          "kind": {
            "type": "string",
            "enum": [
              "blocks",
              "relates"
            ]
          }
        },
        "required": [
          "task_id",
          "related_task_id"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "task_link"
    },
    {
      "tool_name": "task_unlink",
      "description": "Remove a reference between tasks.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id"
          },
          "link_id": {
            "type": "string",
            "description": "Link id"
          }
        },
        "required": [
          "task_id",
          "link_id"
        ]
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "task_unlink"
    },
    {
      "tool_name": "project_create",
      "description": "Create a project to group tasks. Tasks in different projects do not interfere.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name (unique per user)"
          },
          "description": {
            "type": "string",
            "description": "What the project is about"
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "green",
              "purple",
              "orange",
              "pink",
              "gray"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "risk_class": "medium",
      "implementation_type": "declarative",
      "implementation_ref": "project_create"
    },
    {
      "tool_name": "project_list",
      "description": "List the user's projects with their task counts. Call this before creating tasks when the project is not obvious.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "risk_class": "low",
      "implementation_type": "declarative",
      "implementation_ref": "project_list"
    }
  ]
}
