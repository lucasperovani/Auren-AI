# Copy to .env and fill in the values.

# Required: pepper used to hash session tokens. Generate with:
#   openssl rand -hex 32
AUREN_SESSION_SECRET=

# Optional: key used to encrypt credentials at rest. Kept separate from the
# encrypted records. Generate with:
#   openssl rand -hex 32
# When empty, a key is derived from the session secret (development only).
AUREN_CREDENTIAL_ENCRYPTION_KEY=

# Optional: host directory to use as the agent workspace. Relative paths are
# resolved against the directory containing docker-compose.yml.
# Example: AI_WORKSPACE_HOST_PATH=./workspace
# When unset, a named Docker volume is used.
AI_WORKSPACE_HOST_PATH=

# Container path where the workspace is mounted. The default is /workspace.
AI_WORKSPACE_CONTAINER_PATH=/workspace